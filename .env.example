# Server port (Render sets PORT automatically in production)
PORT=3000

# Admin password for the Manage CMS drawer (used to initialize auth if not yet created)
ADMIN_PASSWORD=utsav@2027

# MongoDB Atlas connection string (leave empty locally to use backend/data/portfolio.json)
MONGODB_URI=
MONGODB_DB=portfolio

# Cloudinary credentials for persistent image & PDF resume uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
